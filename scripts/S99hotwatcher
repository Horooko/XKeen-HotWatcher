#!/bin/sh
# Entware init script. Manages ONLY Hot Watcher, never production Xray.
BIN=/opt/sbin/hotwatcher
CONF=/opt/etc/hotwatcher/config.json
ENABLED=/opt/etc/hotwatcher/enabled
PIDFILE=/opt/var/run/hotwatcher.pid
STARTFILE=/opt/var/run/hotwatcher.starttime
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
running() {
 [ -r "$PIDFILE" ] || return 1
 PID=$(cat "$PIDFILE")
 case "$PID" in ''|*[!0-9]*) return 1 ;; esac
 [ -d "/proc/$PID" ] || return 1
 [ -r "$STARTFILE" ] || return 1
 START=$(cat "$STARTFILE")
 NOW=$(awk '{print $22}' "/proc/$PID/stat" 2>/dev/null) || return 1
 [ "$START" = "$NOW" ] || return 1
 same_daemon "$PID"
}
same_daemon() {
 [ -d "/proc/$1" ] || return 1
 EXE=$(readlink "/proc/$1/exe" 2>/dev/null) || return 1
 case "$EXE" in "$BIN"|"$BIN (deleted)") ;; *) return 1 ;; esac
 tr '\000' '\n' < "/proc/$1/cmdline" | grep -q '^daemon$'
}
daemon_pids() {
 for PROC in /proc/[0-9]*; do
  CANDIDATE=${PROC##*/}
  if same_daemon "$CANDIDATE"; then printf '%s\n' "$CANDIDATE"; fi
 done
}
start() {
 if [ -e /opt/var/lib/hotwatcher-updater/pending-update.json ] && [ -z "${HOTWATCHER_UPDATE_ID:-}" ]; then echo 'Pending software update requires recovery; start deferred.' >&2; return 1; fi
 if [ -e /opt/var/lib/hotwatcher-updater/maintenance.json ]; then
  case "${HOTWATCHER_UPDATE_ID:-}" in ''|*[!0-9a-f]*) echo 'Hot Watcher update maintenance active; start deferred.' >&2; return 1;; esac
  grep -q "${HOTWATCHER_UPDATE_ID}" /opt/var/lib/hotwatcher-updater/maintenance.json || return 1
 fi
 [ -f "$ENABLED" ] || { echo 'Hot Watcher disabled (no enabled marker).'; return 0; }
 DAEMONS=$(daemon_pids)
 set -- $DAEMONS
 if [ "$#" -gt 1 ]; then
  echo "Multiple Hot Watcher daemons found ($DAEMONS); start deferred. Stop the old processes before restarting." >&2
  return 1
 fi
 if running; then
  if [ "$#" -ne 1 ] || [ "$1" != "$PID" ] || [ "$(readlink "/proc/$PID/exe" 2>/dev/null)" != "$BIN" ]; then
   echo "Hot Watcher PID $PID is stale or another daemon exists; start deferred." >&2
   return 1
  fi
  echo "Hot Watcher already running: $PID"
  return 0
 fi
 if [ -r "$PIDFILE" ]; then
  PID=$(cat "$PIDFILE")
  case "$PID" in ''|*[!0-9]*) echo 'Unsafe PID file; start deferred.' >&2; return 1;; esac
  if kill -0 "$PID" 2>/dev/null; then
   if same_daemon "$PID" && [ "$#" -eq 1 ] && [ "$1" = "$PID" ] && [ "$(readlink "/proc/$PID/exe" 2>/dev/null)" = "$BIN" ]; then
    awk '{print $22}' "/proc/$PID/stat" > "$STARTFILE"
    echo "Hot Watcher already running: $PID (start marker repaired)."
    return 0
   fi
   echo "Existing PID $PID has unverified identity; start deferred. Inspect /proc/$PID before changing PID files." >&2
   return 1
  fi
  rm -f "$PIDFILE" "$STARTFILE"
 fi
 if [ "$#" -eq 1 ]; then
  echo "Untracked Hot Watcher daemon $1 found; start deferred. Stop it before restarting." >&2
  return 1
 fi
 mkdir -p /opt/var/run
 umask 077
 "$BIN" --config "$CONF" daemon >/dev/null 2>&1 &
 LAUNCHED=$!
 printf '%s\n' "$LAUNCHED" > "$PIDFILE"
 awk '{print $22}' "/proc/$LAUNCHED/stat" > "$STARTFILE"
 N=0
 while [ "$N" -lt 3 ]; do
  sleep 1
  if running; then echo "Hot Watcher started: $PID. Check hotwatcher status and events.jsonl."; return 0; fi
  N=$((N+1))
 done
 if [ "$(cat "$PIDFILE" 2>/dev/null)" = "$LAUNCHED" ] && ! kill -0 "$LAUNCHED" 2>/dev/null; then
  rm -f "$PIDFILE" "$STARTFILE"
 fi
 echo 'Hot Watcher did not stay running; inspect events.jsonl before retrying.' >&2
 return 1
}
stop() {
 if ! running; then
  if [ -r "$PIDFILE" ]; then
   PID=$(cat "$PIDFILE")
   case "$PID" in ''|*[!0-9]*) echo 'Unsafe PID file; stop deferred.' >&2; return 1;; esac
   if kill -0 "$PID" 2>/dev/null; then echo 'Existing PID has unverified identity; stop deferred.' >&2; return 1; fi
   rm -f "$PIDFILE" "$STARTFILE"
  fi
  echo 'Hot Watcher not running.'; return 0
 fi
 LIMIT=${HOTWATCHER_SHUTDOWN_TIMEOUT_SECONDS:-30}
 case "$LIMIT" in ''|*[!0-9]*) echo 'Invalid shutdown timeout.' >&2; return 1;; esac
 kill -TERM "$PID" || return 1
 N=0
 while running && [ "$N" -lt "$LIMIT" ]; do sleep 1; N=$((N+1)); done
 if running; then echo 'Current transaction is still finishing; process was NOT force-killed.'; return 1; fi
 rm -f "$PIDFILE"
 rm -f "$STARTFILE"
 echo 'Hot Watcher stopped. Xray was not stopped.'
}
case "${1:-}" in
 start) start ;;
 stop) stop ;;
 restart) stop && start ;;
 status) if running; then echo "Hot Watcher PID: $PID"; else echo 'Hot Watcher not running.'; fi ;;
 *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
